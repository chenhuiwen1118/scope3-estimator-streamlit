  "capitalization_thresholds": {
    "description": "固定資產認列門檻（台灣企業常見標準）",
    "amount_threshold": {
      "small_enterprise": 10000,
      "medium_enterprise": 30000,
      "large_enterprise": 50000,
      "unit": "TWD",
      "note": "金額 >= 門檻且使用年限 > 2 年，通常列為固定資產"
    },
    "useful_life_threshold": {
      "years": 2,
      "note": "使用年限 > 2 年為固定資產判斷標準之一"
    }
  },

  "special_cases": {
    "description": "特殊處理案例",
    "cases": [
      {
        "scenario": "電腦設備",
        "rule": "金額 >= 30,000 元 → Category 2；金額 < 30,000 元 → Category 1",
        "rationale": "依據企業會計政策決定資本化門檻"
      },
      {
        "scenario": "辦公家具",
        "rule": "整批採購金額 >= 50,000 元 → Category 2；單項或小額 → Category 1",
        "rationale": "整批採購通常作為固定資產"
      },
      {
        "scenario": "軟體授權",
        "rule": "永久授權且金額 >= 門檻 → Category 2；訂閱制或小額 → Category 1",
        "rationale": "永久授權可資本化為無形資產"
      },
      {
        "scenario": "租賃",
        "rule": "融資租賃 → Category 2；營業租賃 → Category 1",
        "rationale": "IFRS 16 租賃會計處理"
      }
    ]
  },

  "ghg_protocol_notes": {
    "category_1_vs_2_distinction": "依據 GHG Protocol，企業應遵循自身的財務會計程序來判斷採購項目是資本財（Category 2）還是購買商品（Category 1）。關鍵在於該項目是否在財務會計中列為固定資產或 PP&E。",
    "timing_difference": "財務會計中固定資產需分年折舊，但 GHG Protocol 建議在購買年度一次性報告全部排放，而非隨折舊攤提。",
    "exclusions": "折舊、攤提等非現金支出不列入 Scope 3 計算。"
  }
}
